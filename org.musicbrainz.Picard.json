{
    "id": "org.musicbrainz.Picard",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "picard",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=all",
        "--filesystem=home",
        "--filesystem=xdg-music",
        "--filesystem=/tmp"
    ],
    "build-options": {
        "env": {
            "PIP_DISABLE_PIP_VERSION_CHECK": "1"
        }
    },
    "modules": [
        "files/python3-build-deps.json",
        {
            "name": "pyqt-sip",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-build-isolation --verbose --prefix=${FLATPAK_DEST} ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/d1/23/16c583dbb6b53e0494dfcf7d1a44778c82e324edda62326727b37f1a5b34/pyqt6_sip-13.12.0.tar.gz",
                    "sha256": "a7ad45c1e3cec3a2473d37ea9870b6c3baeccc560298623c8eb59265714c06e2",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "pyqt6-sip"
                    }
                }
            ]
        },
        {
            "name": "pyqt-builder",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-build-isolation --verbose --prefix=${FLATPAK_DEST} ."
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/61/f6/f3b504b4d55a7c4d3393cb90378501f1f5fc7f233bd85c0375674f84d2af/pyqt_builder-1.19.1.tar.gz",
                    "sha256": "6af6646ba29668751b039bfdced51642cb510e300796b58a4d68b7f956a024d8",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "pyqt-builder"
                    }
                }
            ]
        },
        {
            "name": "pyqt",
            "buildsystem": "simple",
            "build-commands": [
                ". ${FLATPAK_BUILDER_BUILDDIR}/build"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/8b/47/b25c13eca5bebc6505394d0223e46d7ebf0c57dcac2ed908d7d19b18ab6b/pyqt6-6.11.0.tar.gz",
                    "sha256": "45dd60aa69976de1918b5ced6b4e7b6a25abd2a919ecef5fd5826ecc76718889",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "pyqt6"
                    }
                },
                {
                    "type": "file",
                    "path": "pyqt-build",
                    "dest-filename": "build"
                },
                {
                    "type": "shell",
                    "commands": [
                        "echo '[tool.sip.bindings.QtGui]' >> pyproject.toml",
                        "echo 'disabled-features = [\"PyQt_Desktop_OpenGL\"]' >> pyproject.toml"
                    ],
                    "only-arches": [
                        "aarch64"
                    ]
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "chromaprint",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE:STRING=Release",
                "-DBUILD_TOOLS:BOOL=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/acoustid/chromaprint/releases/download/v1.6.1/chromaprint-1.6.1.tar.gz",
                    "sha256": "3368805af0ee47b9df74df10b5001a44569e01df2844dab520031720dde9ad23",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 286,
                        "stable-only": true,
                        "url-template": "https://github.com/acoustid/chromaprint/releases/download/v$version/chromaprint-$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/include",
                "/lib/cmake",
                "/lib/pkgconfig"
            ]
        },
        {
            "name": "libdiscid",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/metabrainz/libdiscid/archive/v0.7.0.tar.gz",
                    "sha256": "ad261d3df0a2761f060cdcbf20c926857f1d5a1862d8b8679433284dd1f2e1cd",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1592,
                        "stable-only": true,
                        "url-template": "https://github.com/metabrainz/libdiscid/archive/v$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig"
            ]
        },
        {
            "name": "rsgain",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "ldflags": "-lpthread",
                "cxxflags": "-lpthread"
            },
            "cleanup": [
                "/share"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/complexlogic/rsgain/releases/download/v3.6/rsgain-3.6-source.tar.xz",
                    "sha256": "26d46f1240a83366e82cbc9121a467fc1dcc977c7adfb4e15c99ead6b3d07ec8",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/complexlogic/rsgain/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"rsgain-\" + $version + \"-source.taz.xz\") | .browser_download_url"
                    }
                }
            ],
            "modules": [
                {
                    "name": "libebur128",
                    "buildsystem": "cmake-ninja",
                    "cleanup": [
                        "/include",
                        "/lib/pkgconfig"
                    ],
                    "config-opts": [
                        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/jiixyj/libebur128/archive/refs/tags/v1.2.6.tar.gz",
                            "sha256": "baa7fc293a3d4651e244d8022ad03ab797ca3c2ad8442c43199afe8059faa613"
                        }
                    ]
                },
                {
                    "name": "inih",
                    "buildsystem": "meson",
                    "cleanup": [
                        "/include",
                        "/lib/pkgconfig"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/benhoyt/inih/archive/refs/tags/r62.tar.gz",
                            "sha256": "9c15fa751bb8093d042dae1b9f125eb45198c32c6704cd5481ccde460d4f8151",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 11600,
                                "stable-only": true,
                                "url-template": "https://github.com/benhoyt/inih/archive/refs/tags/r$version.tar.gz"
                            }
                        }
                    ]
                }
            ]
        },
        "files/python3-deps.json",
        "files/python3-aubio.json",
        {
            "name": "picard",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --compile --config-settings=\"--global-option=build --disable-autoupdate\" --no-build-isolation --prefix=${FLATPAK_DEST} --verbose ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/metabrainz/picard/releases/download/release-3.0.0rc1/picard-3.0.0rc1.tar.gz",
                    "sha256": "3b9dd717a5f012c4d2f0083045f195f928e0610aa65a313a590006c31a2055d8",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 3633,
                        "stable-only": true,
                        "url-template": "https://github.com/metabrainz/picard/releases/download/release-$version/picard-$version.tar.gz"
                    }
                }
            ]
        }
    ]
}
